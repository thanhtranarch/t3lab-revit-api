                                        <Button x:Name="btn_tray_clear" Grid.Column="5"
                                                Content="Clear" Style="{StaticResource T3.Button.Secondary}"
                                                Height="26" Padding="12,0"/>
                                    </Grid>

                                    <!-- Search -->
                                    <Border Grid.Row="1" Height="28" Background="{StaticResource T3.SurfaceSunken}" BorderBrush="{StaticResource T3.Border}"
                                            BorderThickness="1" CornerRadius="4" Padding="8,0" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="&#xE721;" Style="{StaticResource T3.Icon.Field}"/>
                                            <Grid Grid.Column="1">
                                                <TextBlock x:Name="lbl_tray_search_placeholder" Text="Search layers..."
                                                           Foreground="{StaticResource T3.TextDisabled}" FontSize="12.5" VerticalAlignment="Center"
                                                           IsHitTestVisible="False"/>
                                                <TextBox x:Name="txt_tray_layer_search" Background="Transparent" BorderThickness="0"
                                                         Padding="0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                         Height="24" FontSize="12.5" Foreground="{StaticResource T3.Text}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Layer list -->
                                    <Border Grid.Row="2" BorderBrush="{StaticResource T3.Border}" BorderThickness="1"
                                            CornerRadius="4" MinHeight="180" MaxHeight="320">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="pnl_tray_layers" Margin="8,4"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- ─── 7. CONDUIT SETTINGS PANEL ─── -->
                        <StackPanel x:Name="pnl_conduit" Visibility="Collapsed">
                            <!-- Conduit params card -->
                            <Border Background="{StaticResource T3.SurfaceSunken}" BorderBrush="{StaticResource T3.Border}"
                                    BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock Text="CONDUIT TYPE" Style="{StaticResource T3.Label}" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="cmb_conduit_type" Style="{StaticResource T3.ComboBox}" Height="28"
                                                  ToolTip="Conduit type (with or without fittings)"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                                        <TextBlock Text="DIAMETER (MM)" Style="{StaticResource T3.Label}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txt_conduit_diameter" Style="{StaticResource T3.TextBox}" Height="28" Text="25"
                                                 ToolTip="Trade size — snaps to the conduit size table"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0">
                                        <TextBlock Text="OFFSET FROM LEVEL (MM)" Style="{StaticResource T3.Label}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txt_conduit_offset" Style="{StaticResource T3.TextBox}" Height="28" Text="2700"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                                Orientation="Horizontal" Margin="0,12,0,0">
                                        <CheckBox x:Name="chk_conduit_elbows" Content="Auto elbow fittings"
                                                  Style="{StaticResource T3.CheckBox}"
                                                  IsChecked="True" Margin="0,0,24,0"/>
                                        <CheckBox x:Name="chk_conduit_merge" Content="Merge Collinear Lines"
                                                  Style="{StaticResource T3.CheckBox}"
                                                  IsChecked="True"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,8,0,0"
                                               Text="Arcs and curved segments are skipped — straight lines only."
                                               Style="{StaticResource T3.Caption}" Foreground="{StaticResource T3.TextMuted}"/>
                                </Grid>
                            </Border>

                            <!-- Conduit layer card -->
                            <Border Background="{DynamicResource T3.Surface}" BorderBrush="{StaticResource T3.Border}"
                                    BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header row -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="CAD LAYERS (CONDUIT LINES)" Style="{StaticResource T3.Label}" VerticalAlignment="Center"/>
                                        <Button x:Name="btn_conduit_ai" Grid.Column="1"
                                                Content="✨ AI Select" Style="{StaticResource T3.Button.Secondary}"
                                                Height="26" Padding="8,0" ToolTip="AI Smart Match: Intelligently select CAD layers for conduits"/>
                                        <Button x:Name="btn_conduit_select_all" Grid.Column="3"
                                                Content="Select All" Style="{StaticResource T3.Button.Secondary}"
                                                Height="26" Padding="12,0"/>
                                        <Button x:Name="btn_conduit_clear" Grid.Column="5"
                                                Content="Clear" Style="{StaticResource T3.Button.Secondary}"
                                                Height="26" Padding="12,0"/>
                                    </Grid>

                                    <!-- Search -->
                                    <Border Grid.Row="1" Height="28" Background="{StaticResource T3.SurfaceSunken}" BorderBrush="{StaticResource T3.Border}"
                                            BorderThickness="1" CornerRadius="4" Padding="8,0" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="&#xE721;" Style="{StaticResource T3.Icon.Field}"/>
                                            <Grid Grid.Column="1">
                                                <TextBlock x:Name="lbl_conduit_search_placeholder" Text="Search layers..."
                                                           Foreground="{StaticResource T3.TextDisabled}" FontSize="12.5" VerticalAlignment="Center"
                                                           IsHitTestVisible="False"/>
                                                <TextBox x:Name="txt_conduit_layer_search" Background="Transparent" BorderThickness="0"
                                                         Padding="0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                         Height="24" FontSize="12.5" Foreground="{StaticResource T3.Text}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!-- Layer list -->
                                    <Border Grid.Row="2" BorderBrush="{StaticResource T3.Border}" BorderThickness="1"
                                            CornerRadius="4" MinHeight="180" MaxHeight="320">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="pnl_conduit_layers" Margin="8,4"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- ROW 2: FOOTER BAR -->
            </Grid>

            <!-- ══════════════════ ROW 2: UNIFIED FOOTER BAR ══════════════════ -->
            <Border Grid.Row="2" Style="{StaticResource T3.FooterBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource T3.Copyright}"/>
                        <Border Width="1" Height="16" Background="{StaticResource T3.Border}" Margin="12,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txt_status" Text="Select a CAD file and click Refresh"
                                   Style="{StaticResource T3.Body.Secondary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btn_refresh"
                                Content="Refresh"
                                Style="{StaticResource T3.Button.Secondary}"
                                Height="28" Padding="16,0" Margin="0,0,8,0"
                                ToolTip="Reload CAD files and layers"/>

                        <Button x:Name="btn_run"
                                Content="Run"
                                Style="{StaticResource T3.Button.Primary}"
                                Height="28" Padding="16,0" Margin="0,0,8,0"
                                IsDefault="True"
                                ToolTip="Run conversion"/>

                        <Button x:Name="btn_close_bar"
                                Content="Close"
                                Style="{StaticResource T3.Button.Secondary}"
                                Height="28" Padding="16,0"
                                ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
